  "policy": {
    "levels": {
      "8": {
        "connIdle": 300,
        "downlinkOnly": 1,
        "handshake": 4,
        "uplinkOnly": 1
      }
    },
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "routing": {
    "balancers": [
      {
        "selector": [
          "proxy-"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "tag": "proxy-round"
      }
    ],
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "socks"
        ],
        "outboundTag": "dns-out",
        "port": "53",
        "type": "field"
      },
      {
